{
  "manifest_version": 3,
  "name": "Rolynq Clipper",
  "version": "1.0",
  "description": "Clip jobs directly from LinkedIn and YC to your Rolynq dashboard.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["http://localhost:5000/*", "https://*.linkedin.com/*", "https://*.ycombinator.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/jobs/*", "https://www.ycombinator.com/jobs/*"],
      "js": ["content.js"]
    }
  ]
}
