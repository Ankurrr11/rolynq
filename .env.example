# ankur.hunt — Environment Variables
# Copy this to .env and fill in your keys

# ── FREE (no key needed) ──
# Remotive + Arbeitnow work out of the box

# ── Adzuna (free 250/month) — https://developer.adzuna.com ──
ADZUNA_APP_ID=PASTE_HERE
ADZUNA_APP_KEY=PASTE_HERE

# ── JSearch / RapidAPI (free 500/month) — https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch ──
# Provides LinkedIn, Indeed, Glassdoor job data
JSEARCH_API_KEY=PASTE_HERE

# ── SerpAPI (optional, 100/month) — https://serpapi.com ──
SERPAPI_KEY=PASTE_HERE

# ── Google Sheets — Create a blank sheet, copy the ID from the URL ──
GOOGLE_SHEETS_ID=PASTE_HERE

# ── Notion — https://notion.so/my-integrations ──
NOTION_TOKEN=PASTE_HERE
NOTION_DATABASE_ID=PASTE_HERE

# ── Slack — Create an incoming webhook at https://api.slack.com/messaging/webhooks ──
SLACK_WEBHOOK_URL=PASTE_HERE
