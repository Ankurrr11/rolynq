dist-ssr/
*.local

# Environment & Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
token.json
credentials.json

# IDEs
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Large / Temp files
temp_zip/
backend.log
frontend.log
instance/
*.mp4
*.pdf
*.zip
*.docx
